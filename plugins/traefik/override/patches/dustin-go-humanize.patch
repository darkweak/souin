@@ -204,4 +204,13 @@
 	}
 
 	return 0, fmt.Errorf("unhandled size name: %v", extra)
+}
+
+// nonNegative replaces max(n, 0): Yaegi does not know the go1.21 builtins.
+func nonNegative(n int) int {
+	if n < 0 {
+		return 0
+	}
+
+	return n
 }
